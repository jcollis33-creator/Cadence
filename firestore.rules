rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Closed by default. Only a signed-in person can read or write their own tree.
    // Nothing here is world-readable. Payloads are ciphertext; these rules still
    // refuse every other account.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /profiles/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /shared/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
